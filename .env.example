POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
POSTGRES_PORT=5432

# Superuser connection, used to run goose migrations (needs table-owner
# privileges to create roles, tables, and RLS policies).
DATABASE_URL=postgres://platform:platform@localhost:5432/platform?sslmode=disable

# Non-superuser role connection, used by application services so RLS
# (ADR-0010) is actually enforced rather than bypassed. Created by
# migration 0001.
APP_DATABASE_URL=postgres://platform_app:platform_app@localhost:5432/platform?sslmode=disable

# Required, no default — apiserver refuses to start without it (ADR-0008
# JWT access tokens). Generate a real random value outside of local dev,
# e.g. `openssl rand -base64 32`.
JWT_SIGNING_KEY=local-dev-only-change-me

# services/apiserver
APISERVER_LISTEN_ADDR=:8080
# Phase 1 has exactly one worker, called directly over HTTP
# (docs/worker-agent-contract.md); Phase 2 adds real scheduling across
# multiple workers.
WORKER_ADDR=http://localhost:7100

# services/worker
WORKER_LISTEN_ADDR=:7100
# Phase 2: node registration + heartbeat over NATS (docs/nats-contract.md),
# additive to the HTTP contract above. Worker retries connecting to NATS for
# up to 30s at startup, then continues in HTTP-only mode if it never
# connects.
WORKER_NATS_URL=nats://127.0.0.1:4222
# UUID persisted here on first run so restarts re-register as the same node.
WORKER_NODE_ID_FILE=worker-node-id
# Left unset, hostname/outbound IP are auto-detected.
WORKER_HOSTNAME=
WORKER_IP=
# Artificial per-process capacity ceiling (ADR-0009 logical-node simulation).
WORKER_CPU_CAPACITY_MILLICORES=2000
WORKER_MEMORY_CAPACITY_MB=2048
WORKER_HEARTBEAT_INTERVAL=5s
